# ─────────────────────────────────────────────
#  Keycloak — Main App Client
# ─────────────────────────────────────────────
# Base URL of your Keycloak server (no trailing slash)
KEYCLOAK_BASE_URL=http://localhost:8080

# The realm you created in Keycloak
KEYCLOAK_REALM=my-realm

# Keycloak → Clients → your-client → Settings tab → Client ID
KEYCLOAK_CLIENT_ID=my-app

# Keycloak → Clients → your-client → Credentials tab → Client Secret
# (Client authentication must be ON)
KEYCLOAK_CLIENT_SECRET=replace-with-your-client-secret

# ─────────────────────────────────────────────
#  Keycloak — Service Account Client
#  (NOT used for logout — only for machine-to-machine admin tasks
#   e.g. nightly jobs, bulk user ops, realm stats)
# ─────────────────────────────────────────────
# Create a SEPARATE confidential client in Keycloak for this:
#   Keycloak → Clients → Create
#     Client ID:              my-app-sa          ← KC_SA_CLIENT_ID
#     Client authentication:  ON
#     Authentication flow:    Service accounts roles  (only this, uncheck rest)
#   Then assign it the manage-users role:
#     Keycloak → Clients → my-app-sa → Service accounts roles tab
#     → Assign role → Filter by client → realm-management → manage-users
#
# Logout uses KEYCLOAK_CLIENT_ID + KEYCLOAK_CLIENT_SECRET + refresh_token instead.
KC_SA_CLIENT_ID=my-app-sa
KC_SA_CLIENT_SECRET=replace-with-service-account-secret

# ─────────────────────────────────────────────
#  Application URLs
# ─────────────────────────────────────────────
# Must match exactly the Redirect URI registered in Keycloak client:
#   Keycloak → Clients → your-client → Settings → Valid redirect URIs
APP_CALLBACK_URL=http://localhost:8000/auth/callback

# ─────────────────────────────────────────────
#  Session
# ─────────────────────────────────────────────
# Random string used to sign session cookies — keep this secret in production
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# ─────────────────────────────────────────────
#  Redis (session store)
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
#  Server
# ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Frontend origin — used for CORS and post-logout redirect
FRONTEND_URL=http://localhost:5173
